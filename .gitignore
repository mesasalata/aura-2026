# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local capture output (screenshots from scripts/)
/scripts/shots/

# Fal generator scratch (auth headers / request bodies)
/public/art/video/._*
/scripts/.cache/

# Fal candidates awaiting a human pick
public/art/gen/review/

# Blender sources - export .glb into public/art/, do not commit the .blend
/assets/keep/cow.blend
/assets/keep/cow.blend1
/assets/keep/cow.blend2
/assets/keep/udder.blend
/assets/keep/udder.blend1
/assets/keep/udder.blend2
